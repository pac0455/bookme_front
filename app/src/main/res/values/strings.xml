    <!-- FAQ Questions and Answers -->
    <string name="faq_reserve_question">¿Cómo puedo hacer una reserva?</string>
    <string name="faq_reserve_answer">Para hacer una reserva, ve a la sección "Servicios", selecciona el servicio que deseas, elige la fecha y hora disponible, y confirma tu reserva. Recibirás una confirmación por email.</string>
    <string name="faq_cancel_question">¿Puedo cancelar mi reserva?</string>
    <string name="faq_cancel_answer">Sí, puedes cancelar tu reserva. Ve a Mis Reservas, selecciona la reserva que deseas cancelar y toca "Cancelar".En ese momento el pago aparecerá como cancelado</string>
    <string name="faq_profile_update_question">¿Cómo actualizo mi perfil?</string>
    <string name="faq_profile_update_answer">Ve a la sección "Perfil" en el menú principal, toca "Editar perfil" y actualiza la información que desees. No olvides guardar los cambios.</string>
    <string name="faq_email_change_answer">Por temas técnicos no es posible cambiar el gmail de la cuenta</string>
    <string name="faq_payment_methods_question">¿Qué métodos de pago aceptan?</string>
    <string name="faq_payment_methods_answer">Aceptamos tarjetas de crédito/débito, PayPal, transferencias bancarias y pagos en efectivo (según el establecimiento).</string>
    <string name="faq_refunds_question">¿Existen reembolsos de pagos?</string>
    <string name="faq_refunds_answer">Un pago solo es reembolsado en el caso de que el estableciento haya cerrado o la reserva este cancelada</string>
    <string name="faq_contact_support_question">¿Cómo contacto con soporte?</string>
    <string name="faq_contact_support_answer">Puedes contactarnos a través del email soporte@gmail.com. Nuestro horario de atención es de 9:00 a 18:00, de lunes a viernes.</string>
    <string name="faq_offline_question">¿La app funciona sin internet?</string>
    <string name="faq_offline_answer">No debido a que sino, no podremos conseguir datos esenciales para mostrarte</string>

